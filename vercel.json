{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://sentinel-backend-q89c.onrender.com/api/:match*"
    },
    {
      "source": "/auth/:match*",
      "destination": "https://sentinel-backend-q89c.onrender.com/api/auth/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
